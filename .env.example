# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=username
DB_PASSWORD=
DB_NAME=payment_gateway
DB_SSLMODE=disable

# Security
API_KEY_SECRET=your-api-key-secret-here

# Admin Dashboard Login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
JWT_SECRET=jwt-secret-ganti-ini-dengan-string-panjang-acak

# Base URL publik aplikasi (dipakai untuk callback & redirect DANA Gapura)
APP_URL=http://localhost:3000

# CORS (gunakan domain frontend production)
CORS_ORIGIN=*
